{
  "title": "Pipeline Configuration",
  "description": "Pipeline 适配器配置 Schema",
  "type": "object",
  "properties": {
    "patternProperties": {
      "llm|asr|tts|ocr": {
        "type": "object",
        "description": "适配器配置",
        "additionalProperties": false,
        "patternProperties": {
          "^.*$": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "适配器标识"
              },
              "description": { "type": "string" },
              "tags": {
                "type": "array",
                "items": { "type": "string" }
              },
              "config": {
                "type": "object",
                "patternProperties": {
                  "^.*$": {
                    "type": "object",
                    "properties": {
                      "enabled": {
                        "type": "boolean",
                        "description": "是否许可启用"
                      },
                      "name": {
                        "type": "string"
                      },
                      "description": { "type": "string" },
                      "value": {
                        "type": "string",
                        "description": "配置值"
                      },
                      "options": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": ["enabled", "name", "description", "value"]
                  }
                }
              }
            },
            "required": ["name", "description", "config"]
          }
        }
      }
    }
  },
  "required": ["llm", "asr", "tts", "ocr"]
}
