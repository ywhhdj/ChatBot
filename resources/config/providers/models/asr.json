{
  "schema_version": 1,
  "whisper": {
    "meta": {
      "label": "Whisper 本地",
      "tags": [
        "local",
        "free",
        "asr",
        "audio"
      ],
      "deployment": "local",
      "description": "faster-whisper 本地推理"
    },
    "endpoint": {
      "transport": "local",
      "runtime": "faster-whisper",
      "model_dir": "${ASR_MODEL_ROOT}/whisper",
      "device": "auto"
    },
    "models": [
      {
        "id": "base",
        "label": "Whisper Base",
        "params": {
          "model_size": {
            "default": "base"
          }
        }
      },
      {
        "id": "small",
        "label": "Whisper Small",
        "params": {
          "model_size": {
            "default": "small"
          }
        }
      }
    ],
    "params": {
      "language": {
        "type": "string",
        "label": "识别语言",
        "default": "zh",
        "required": false,
        "scope": "request",
        "enum": [
          {
            "value": "zh",
            "label": "中文"
          },
          {
            "value": "en",
            "label": "英语"
          },
          {
            "value": "ja",
            "label": "日语"
          }
        ]
      },
      "model_size": {
        "type": "string",
        "label": "模型规格",
        "default": "base",
        "required": false,
        "scope": "init",
        "enum": [
          {
            "value": "tiny",
            "label": "Tiny"
          },
          {
            "value": "base",
            "label": "Base"
          },
          {
            "value": "small",
            "label": "Small"
          },
          {
            "value": "medium",
            "label": "Medium"
          }
        ]
      },
      "beam_size": {
        "type": "integer",
        "label": "Beam Size",
        "default": 5,
        "min": 1,
        "max": 10,
        "required": false,
        "scope": "request"
      }
    }
  }
}