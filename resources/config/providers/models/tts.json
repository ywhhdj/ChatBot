{
  "schema_version": 1,
  "aivis": {
    "meta": {
      "label": "AIVIS",
      "tags": [
        "cloud",
        "paid",
        "tts",
        "audio"
      ],
      "deployment": "cloud"
    },
    "endpoint": {
      "transport": "http",
      "base_url": "${AIVIS_API_URL}",
      "chat_path": "",
      "auth": {
        "type": "bearer",
        "header": "Authorization",
        "prefix": "Bearer ",
        "field": "api_key"
      }
    },
    "models": [
      {
        "id": "aivis-default",
        "label": "AIVIS 默认模型"
      }
    ],
    "params": {
      "model_uuid": {
        "type": "string",
        "label": "模型 UUID",
        "default": null,
        "required": true,
        "scope": "init"
      },
      "speaker_uuid": {
        "type": "string",
        "label": "说话人 UUID",
        "default": null,
        "required": false,
        "scope": "init"
      },
      "style_id": {
        "type": "integer",
        "label": "风格 ID",
        "default": null,
        "min": 0,
        "max": 31,
        "required": false,
        "scope": "init"
      },
      "style_name": {
        "type": "string",
        "label": "风格名称",
        "default": null,
        "required": false,
        "scope": "init"
      },
      "language": {
        "type": "string",
        "label": "语言",
        "default": "ja",
        "required": false,
        "scope": "request"
      },
      "audio_format": {
        "type": "string",
        "label": "音频格式",
        "default": "mp3",
        "required": false,
        "scope": "request",
        "enum": [
          {
            "value": "wav",
            "label": "WAV"
          },
          {
            "value": "mp3",
            "label": "MP3"
          },
          {
            "value": "flac",
            "label": "FLAC"
          },
          {
            "value": "aac",
            "label": "AAC"
          },
          {
            "value": "opus",
            "label": "OPUS"
          }
        ]
      }
    }
  },
  "bv2": {
    "meta": {
      "label": "BV2",
      "tags": [
        "local",
        "free",
        "tts",
        "audio"
      ],
      "deployment": "local"
    },
    "endpoint": {
      "transport": "http",
      "base_url": "${BV2_API_URL}",
      "auth": {
        "type": "none"
      }
    },
    "models": [
      {
        "id": "bv2",
        "label": "BV2"
      }
    ],
    "params": {
      "speaker_id": {
        "type": "integer",
        "label": "说话人 ID",
        "default": 0,
        "scope": "request"
      },
      "audio_format": {
        "type": "string",
        "label": "音频格式",
        "default": "wav",
        "scope": "request"
      },
      "lang": {
        "type": "string",
        "label": "语言",
        "default": "zh",
        "scope": "request"
      },
      "length": {
        "type": "number",
        "label": "语速",
        "default": 1.0,
        "scope": "request"
      }
    }
  },
  "gptsovits": {
    "meta": {
      "label": "GPT-SoVITS",
      "tags": [
        "local",
        "free",
        "tts",
        "audio"
      ],
      "deployment": "local"
    },
    "endpoint": {
      "transport": "http",
      "base_url": "${GPTSOVITS_API_URL}",
      "auth": {
        "type": "none"
      }
    },
    "models": [
      {
        "id": "gptsovits",
        "label": "GPT-SoVITS"
      }
    ],
    "params": {
      "prompt_language": {
        "type": "string",
        "label": "提示语言",
        "default": "zh",
        "scope": "request"
      },
      "text_language": {
        "type": "string",
        "label": "文本语言",
        "default": "zh",
        "scope": "request"
      },
      "speed_factor": {
        "type": "number",
        "label": "语速",
        "default": 1.0,
        "scope": "request"
      },
      "top_k": {
        "type": "integer",
        "label": "Top K",
        "default": 15,
        "scope": "request"
      },
      "top_p": {
        "type": "number",
        "label": "Top P",
        "default": 100.0,
        "scope": "request"
      },
      "temperature": {
        "type": "number",
        "label": "温度",
        "default": 1.0,
        "scope": "request"
      }
    }
  },
  "vits": {
    "meta": {
      "label": "VITS",
      "tags": [
        "local",
        "free",
        "tts",
        "audio"
      ],
      "deployment": "local"
    },
    "endpoint": {
      "transport": "http",
      "base_url": "${VITS_API_URL}",
      "auth": {
        "type": "none"
      }
    },
    "models": [
      {
        "id": "vits",
        "label": "VITS"
      }
    ],
    "params": {
      "ref_audio_path": {
        "type": "string",
        "label": "参考音频路径",
        "default": "",
        "scope": "request"
      },
      "prompt_language": {
        "type": "string",
        "label": "提示语言",
        "default": "zh",
        "scope": "request"
      },
      "text_language": {
        "type": "string",
        "label": "文本语言",
        "default": "zh",
        "scope": "request"
      },
      "speed_factor": {
        "type": "number",
        "label": "语速",
        "default": 1.0,
        "scope": "request"
      }
    }
  }
}