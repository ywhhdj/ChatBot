{
  "schema_version": 1,
  "chatgpt": {
    "meta": {
      "label": "ChatGPT",
      "tags": [
        "cloud",
        "paid",
        "llm",
        "text"
      ],
      "deployment": "cloud",
      "region": "us",
      "description": "OpenAI 官方兼容 API",
      "docs_url": "https://platform.openai.com/docs"
    },
    "endpoint": {
      "transport": "http",
      "base_url": "https://api.openai.com/v1",
      "chat_path": "/chat/completions",
      "auth": {
        "type": "bearer",
        "header": "Authorization",
        "prefix": "Bearer ",
        "field": "api_key"
      },
      "timeout": 20,
      "max_retries": 1
    },
    "models": [
      {
        "id": "gpt-3.5-turbo",
        "label": "GPT-3.5 Turbo",
        "tags": [
          "text"
        ]
      }
    ],
    "params": {
      "max_tokens": {
        "default": 1024
      }
    }
  },
  "deepseek": {
    "meta": {
      "label": "DeepSeek",
      "tags": [
        "cloud",
        "paid",
        "llm",
        "text"
      ],
      "deployment": "cloud",
      "region": "cn",
      "description": "DeepSeek 官方 API"
    },
    "endpoint": {
      "transport": "http",
      "base_url": "https://api.deepseek.com",
      "chat_path": "/chat/completions",
      "auth": {
        "type": "bearer",
        "header": "Authorization",
        "prefix": "Bearer ",
        "field": "api_key"
      },
      "timeout": 60.0,
      "max_retries": 3
    },
    "models": [
      {
        "id": "deepseek-v4-flash",
        "label": "DeepSeek V4 Flash"
      },
      {
        "id": "deepseek-v4-pro",
        "label": "DeepSeek V4 Pro"
      }
    ],
    "params": {}
  },
  "ollama": {
    "meta": {
      "label": "Ollama",
      "tags": [
        "local",
        "free",
        "llm",
        "text"
      ],
      "deployment": "local",
      "description": "本机 Ollama 服务"
    },
    "endpoint": {
      "transport": "http",
      "base_url": "http://localhost:11434",
      "chat_path": "/api/chat",
      "protocol": "ollama",
      "auth": {
        "type": "none"
      },
      "timeout": 20.0,
      "max_retries": 3
    },
    "models": [],
    "params": {
      "num_ctx": {
        "type": "integer",
        "label": "上下文长度",
        "default": 2048,
        "required": false,
        "scope": "request"
      },
      "keep_alive": {
        "type": "string",
        "label": "保活时长",
        "default": "5m",
        "required": false,
        "scope": "request"
      }
    }
  }
}