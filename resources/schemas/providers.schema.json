{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/schemas/providers.schema.json",
  "title": "Provider Definitions (models/*.json)",
  "type": "object",
  "required": [
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "capability": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "patternProperties": {
    "^(?!schema_version$|capability$|description$|\\$schema$)[A-Za-z0-9_.-]+$": {
      "$ref": "#/$defs/Provider"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Provider": {
      "type": "object",
      "required": [
        "meta",
        "endpoint"
      ],
      "properties": {
        "meta": {
          "$ref": "#/$defs/Meta"
        },
        "endpoint": {
          "$ref": "#/$defs/Endpoint"
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Model"
          }
        },
        "params": {
          "$ref": "#/$defs/Params"
        }
      },
      "additionalProperties": false
    },
    "Meta": {
      "type": "object",
      "required": [
        "label",
        "tags",
        "deployment"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "deployment": {
          "enum": [
            "cloud",
            "local"
          ]
        },
        "region": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "docs_url": {
          "type": "string",
          "format": "uri"
        },
        "streaming": {
          "type": "boolean"
        },
        "task_type": {
          "enum": [
            "chat",
            "grounding",
            "ocr",
            "tts",
            "asr",
            "image"
          ]
        },
        "output_parser": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "Endpoint": {
      "type": "object",
      "required": [
        "transport"
      ],
      "properties": {
        "transport": {
          "enum": [
            "http",
            "local",
            "websocket"
          ]
        },
        "base_url": {
          "type": "string"
        },
        "websocket_url": {
          "type": "string"
        },
        "chat_path": {
          "type": "string"
        },
        "speech_path": {
          "type": "string"
        },
        "synthesize_path": {
          "type": "string"
        },
        "image_path": {
          "type": "string"
        },
        "prompt_path": {
          "type": "string"
        },
        "grounding_path": {
          "type": "string"
        },
        "runtime": {
          "type": "string"
        },
        "model_dir": {
          "type": "string"
        },
        "device": {
          "type": "string"
        },
        "protocol": {
          "type": "string"
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "timeout": {
          "type": "number",
          "minimum": 0
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "auth": {
          "$ref": "#/$defs/Auth"
        },
        "stream_transport": {
          "enum": [
            "http-chunked",
            "sse",
            "websocket"
          ]
        },
        "first_chunk_timeout_ms": {
          "type": "integer",
          "minimum": 0
        },
        "first_result_timeout_ms": {
          "type": "integer",
          "minimum": 0
        },
        "download":{
          "type": "object",
          "properties": { 
            "provider": {
              "type": "string"
            },
            "urls": {
              "type": "object"
            },
            "size_mb": {
              "type": "number"
            },
            "license": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "docs_url": {
              "type": "string"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "transport": {
                "const": "http"
              }
            },
            "required": [
              "transport"
            ]
          },
          "then": {
            "required": [
              "base_url"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "transport": {
                "const": "local"
              }
            },
            "required": [
              "transport"
            ]
          },
          "then": {
            "required": [
              "runtime"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "transport": {
                "const": "websocket"
              }
            },
            "required": [
              "transport"
            ]
          },
          "then": {
            "required": [
              "websocket_url"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "Auth": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "none",
            "bearer",
            "header",
            "basic",
            "query"
          ]
        },
        "header": {
          "type": "string"
        },
        "prefix": {
          "type": "string"
        },
        "field": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "bearer",
                  "header",
                  "basic",
                  "query"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "field"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "Model": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "params": {
          "$ref": "#/$defs/Params"
        }
      },
      "additionalProperties": true
    },
    "Params": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ParamDescriptor"
      }
    },
    "ParamDescriptor": {
      "type": "object",
      "required": [
        "type",
        "scope"
      ],
      "properties": {
        "type": {
          "enum": [
            "string",
            "number",
            "integer",
            "boolean",
            "array",
            "object"
          ]
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "default": {},
        "required": {
          "type": "boolean"
        },
        "scope": {
          "enum": [
            "init",
            "connection",
            "request"
          ]
        },
        "hidden": {
          "type": "boolean"
        },
        "ui": {
          "type": "string"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number"
        },
        "enum": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "value",
              "label"
            ],
            "properties": {
              "value": {},
              "label": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "items": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}