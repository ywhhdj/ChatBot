{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "ui/**/*",
    "ui/**/*.vue"
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts",
    "src",
    "mobile",
    "docs",
    "static",
    "resources"
  ],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": {
      "@/*": [
        "./ui/*"
      ]
    }
  }
}