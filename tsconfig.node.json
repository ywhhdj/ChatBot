{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": [
    "vite.config.*",
    "vitest.config.*",
    "nightwatch.conf.*",
    "playwright.config.*",
    "tailwind.config.*"
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts",
    "src",
    "mobile",
    "docs",
    "static",
    "resources"
  ],
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node",
      "vue"
    ]
  }
}